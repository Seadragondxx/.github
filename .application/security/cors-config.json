{
  "_comment": "CORS configuration for API endpoints",

  "development": {
    "origins": ["http://localhost:3000", "http://127.0.0.1:3000"],
    "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With", "X-CSRF-Token"],
    "exposed_headers": ["X-Total-Count", "X-Page-Count"],
    "credentials": true,
    "max_age": 600
  },

  "staging": {
    "origins": ["https://staging.example.com"],
    "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-CSRF-Token"],
    "exposed_headers": ["X-Total-Count"],
    "credentials": true,
    "max_age": 3600
  },

  "production": {
    "origins": ["https://example.com", "https://www.example.com"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-CSRF-Token"],
    "exposed_headers": [],
    "credentials": true,
    "max_age": 86400
  },

  "api_public": {
    "origins": ["*"],
    "methods": ["GET", "OPTIONS"],
    "allowed_headers": ["Content-Type"],
    "exposed_headers": [],
    "credentials": false,
    "max_age": 86400,
    "notes": "For public read-only APIs"
  },

  "next_config_example": {
    "code": "// next.config.js\nmodule.exports = {\n  async headers() {\n    return [\n      {\n        source: '/api/:path*',\n        headers: [\n          { key: 'Access-Control-Allow-Origin', value: 'https://example.com' },\n          { key: 'Access-Control-Allow-Methods', value: 'GET,POST,PUT,DELETE,OPTIONS' },\n          { key: 'Access-Control-Allow-Headers', value: 'Content-Type,Authorization' },\n          { key: 'Access-Control-Allow-Credentials', value: 'true' },\n        ],\n      },\n    ];\n  },\n};"
  }
}
