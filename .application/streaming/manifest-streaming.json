{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Get0ff Live",
  "short_name": "Get0ff",
  "description": "Live DJ streaming platform for performers",
  "version": "1.0.0",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#0f172a",
  "background_color": "#000000",
  "lang": "en-US",
  "categories": ["entertainment", "music", "social"],

  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Go Live",
      "short_name": "Live",
      "description": "Start streaming",
      "url": "/studio/live",
      "icons": [{ "src": "/icons/shortcut-live.png", "sizes": "96x96" }]
    },
    {
      "name": "My Mixes",
      "short_name": "Mixes",
      "description": "Play recorded mixes",
      "url": "/mixes",
      "icons": [{ "src": "/icons/shortcut-mixes.png", "sizes": "96x96" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View earnings and stats",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/shortcut-dashboard.png", "sizes": "96x96" }]
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/studio-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DJ Studio - Desktop"
    },
    {
      "src": "/screenshots/studio-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "DJ Studio - Mobile"
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "handle_links": "preferred",

  "protocol_handlers": [
    {
      "protocol": "web+get0ff",
      "url": "/join?room=%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/flac": [".flac"],
        "audio/aac": [".aac", ".m4a"],
        "audio/ogg": [".ogg"]
      }
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*"]
        }
      ]
    }
  },

  "related_applications": [],
  "prefer_related_applications": false
}
